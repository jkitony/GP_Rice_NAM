    print(f"Detected local-score region: Chr{peak_chr}:{detected_start_bp:,}-{detected_end_bp:,}")
print(f"Genes plotted: {0 if genes_df.empty else len(genes_df)}")
print(f"Gene labels plotted: {0 if label_df.empty else len(label_df)}")
