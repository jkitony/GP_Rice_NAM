  "Fourteen_projected_20k",
  "Fourteen_projected_40k"
)

# figure sizes
manh_width  <- 2.5
manh_height <- 1.5
qq_width    <- 2.2
qq_height   <- 2.2

png_res <- 600

# thresholds
show_fdr_line        <- TRUE
show_bonferroni_line <- TRUE
show_suggestive_line <- FALSE
fdr_thresh           <- 0.05
bonf_alpha           <- 0.05
suggestive_p         <- 1e-5

ylim_max <- 12

compute_thresholds <- function(mht, fdr_thresh = 0.05, bonf_alpha = 0.05) {
  n_markers <- nrow(mht)
  
  bonf_p <- bonf_alpha / n_markers
  bonf_line <- -log10(bonf_p)
  
  fdr_cutoff_p <- NA
  fdr_line <- NA
  
  if ("FDR" %in% colnames(mht) && any(mht$FDR < fdr_thresh, na.rm = TRUE)) {
    fdr_cutoff_p <- max(mht$P[mht$FDR < fdr_thresh], na.rm = TRUE)
    fdr_line <- -log10(fdr_cutoff_p)
  }
  
  list(
    n_markers = n_markers,
    bonf_p = bonf_p,
    bonf_line = bonf_line,
    fdr_cutoff_p = fdr_cutoff_p,
    fdr_line = fdr_line
  )
}

plot_manhattan_compact <- function(
    mht,
    trait_name,
    out_png,
    out_pdf,
    ylim_max = 12,
    show_fdr_line = TRUE,
    show_bonferroni_line = TRUE,
    show_suggestive_line = FALSE,
    fdr_thresh = 0.05,
    bonf_alpha = 0.05,
    suggestive_p = 1e-5,
    width = 2.5,
    height = 1.5,
    res = 600
) {
  thresholds <- compute_thresholds(mht, fdr_thresh, bonf_alpha)
  
  draw_plot <- function() {
    par(
      mar = c(2.6, 2.8, 1.2, 0.4),
      mgp = c(1.45, 0.42, 0),
      tcl = -0.22,
      font.lab = 2,
      font.axis = 2,
      font.main = 2
    )
    
    manhattan(
      mht,
      genomewideline = FALSE,
      suggestiveline = FALSE,
      ylim = c(0, ylim_max),
      cex = 0.38,
      cex.axis = 0.72,
      cex.lab = 0.82,
      ylab = expression(-log[10](P)),
      main = NULL
    )
    
    title(main = trait_name, cex.main = 0.82, line = 0.15, font.main = 2)
    
    if (show_fdr_line && !is.na(thresholds$fdr_line)) {
      abline(h = thresholds$fdr_line, col = "blue", lwd = 1)
    }
    
    if (show_bonferroni_line) {
      abline(h = thresholds$bonf_line, col = "red", lwd = 1, lty = 2)
    }
    
    if (show_suggestive_line) {
      abline(h = -log10(suggestive_p), col = "darkgray", lwd = 0.8, lty = 3)
    }
  }
  
  png(out_png, width = width, height = height, units = "in", res = res)
  draw_plot()
  dev.off()
  
  pdf(out_pdf, width = width, height = height, useDingbats = FALSE)
  draw_plot()
  dev.off()
}

plot_qq_compact <- function(
    pvals,
    trait_name,
    out_png,
    out_pdf,
    width = 2.2,
    height = 2.2,
    res = 600
) {
  pvals <- pvals[is.finite(pvals) & !is.na(pvals) & pvals > 0]
  
  draw_plot <- function() {
    par(
      mar = c(2.8, 2.8, 1.2, 0.4),
      mgp = c(1.55, 0.45, 0),
      tcl = -0.22,
      font.lab = 2,
      font.axis = 2,
      font.main = 2
    )
    
    qq(
      pvals,
      main = NULL,
      cex = 0.45,
      cex.axis = 0.8,
      cex.lab = 0.85,
      xlab = expression(Expected~~-log[10](P)),
      ylab = expression(Observed~~-log[10](P))
    )
    
    title(main = trait_name, cex.main = 0.85, line = 0.15, font.main = 2)
  }
  
  png(out_png, width = width, height = height, units = "in", res = res)
  draw_plot()
  dev.off()
  
  pdf(out_pdf, width = width, height = height, useDingbats = FALSE)
  draw_plot()
  dev.off()
}

# ---------------------------------------------------------
# Rebuild all plots from saved GWAS result CSV files
# ---------------------------------------------------------
for (panel_name in panel_names) {
  
  cat("\nRe-plotting:", panel_name, "\n")
  
  outdir <- file.path(base_outdir, panel_name)
  
  for (trait_name in traits_to_run) {
    
    gwas_file <- file.path(outdir, "qtls", paste0(trait_name, "_all_GWAS_results.csv"))
    
    if (!file.exists(gwas_file)) {
      cat("Skipping missing file:", gwas_file, "\n")
      next
    }
    
    mht <- read.csv(gwas_file, stringsAsFactors = FALSE)
    
    needed_cols <- c("SNP", "CHR", "BP", "P")
    if (!all(needed_cols %in% colnames(mht))) {
      cat("Skipping malformed file:", gwas_file, "\n")
      next
    }
    
    if (!"FDR" %in% colnames(mht)) {
      mht$FDR <- p.adjust(mht$P, method = "BH")
    }
    
    mht <- mht[is.finite(mht$P) & !is.na(mht$P) & mht$P > 0, , drop = FALSE]
    
    if (nrow(mht) == 0) {
      cat("No valid rows in:", gwas_file, "\n")
      next
    }
    
    plot_manhattan_compact(
      mht = mht,
      trait_name = trait_name,
      out_png = file.path(outdir, "plots", "manhattan_png", paste0(trait_name, "_manhattan.png")),
      out_pdf = file.path(outdir, "plots", "manhattan_pdf", paste0(trait_name, "_manhattan.pdf")),
      ylim_max = ylim_max,
      show_fdr_line = show_fdr_line,
      show_bonferroni_line = show_bonferroni_line,
      show_suggestive_line = show_suggestive_line,
      fdr_thresh = fdr_thresh,
      bonf_alpha = bonf_alpha,
      suggestive_p = suggestive_p,
      width = manh_width,
      height = manh_height,
      res = png_res
    )
    
    plot_qq_compact(
      pvals = mht$P,
      trait_name = trait_name,
      out_png = file.path(outdir, "plots", "qq_png", paste0(trait_name, "_QQ.png")),
      out_pdf = file.path(outdir, "plots", "qq_pdf", paste0(trait_name, "_QQ.pdf")),
      width = qq_width,
      height = qq_height,
      res = png_res
    )
    
    cat("Saved:", panel_name, trait_name, "\n")
  }
}

cat("\nDone. All plots overwritten as high-resolution PDF and PNG.\n")

