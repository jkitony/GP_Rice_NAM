    max_missing = max_missing,
    n_folds = n_folds,
    cv_seed = cv_seed,
    n_iter = n_iter,
    burn_in = burn_in,
    thin = thin,
    kernel_h = kernel_h,
    common_individuals = common_ids,
    imputation = "Training-fold marker means",
    rrBLUP_model = "Marker-effect ridge regression"
  ),
