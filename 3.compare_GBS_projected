save_figure <- function(plot, name, width, height) {
  
  ggsave(
    file.path(outdir, paste0(name, ".pdf")),
    plot = plot,
    width = width,
    height = height
  )
  
  ggsave(
    file.path(outdir, paste0(name, ".png")),
    plot = plot,
    width = width,
    height = height,
    dpi = 300
  )
}

save_figure(
  p_trait, "GBS_vs_projected_traitwise", 10, 7
)

save_figure(
  p_difference, "Projected_minus_GBS_traitwise", 10, 7
)

save_figure(
  p_overall, "GBS_vs_projected_overall", 7, 4.5
)

###############################################################################
# 13. Save settings and software information
###############################################################################

saveRDS(
  list(
    phenotype_file = pheno_file,
    vcf_files = vcf_files,
