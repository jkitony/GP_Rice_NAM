import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# =====================
# Input
# =====================
file = "Phenos_2018_14fam_1822lines.csv"
df = pd.read_csv(file)

traits = ["DTH", "CL", "PL", "PRL", "PN", "PW", "SW", "NPB", "NSPP", "BM", "SSR"]

parent_lookup = {
    2: "WRC02",
    4: "WRC04",
    27: "WRC27",
    28: "WRC28",
    29: "WRC29",
    30: "WRC30",
    31: "WRC31",
    32: "WRC32",
    33: "WRC33",
    34: "WRC34",
    35: "WRC35",
    36: "WRC36",
    39: "WRC39",
    40: "WRC40"
}

family_order = list(parent_lookup.keys())
family_labels = [f"F{f}" for f in family_order]

# Ensure numeric
df["Family"] = pd.to_numeric(df["Family"], errors="coerce")

for tr in traits:
    df[tr] = pd.to_numeric(df[tr], errors="coerce")

# Keep only target families
df = df[df["Family"].isin(family_order)].copy()

# =====================
# Impute missing values by family mean within each trait
# =====================
for tr in traits:
    df[tr] = df.groupby("Family")[tr].transform(lambda x: x.fillna(x.mean()))

# If an entire family-trait is all NA, fill with overall trait mean
for tr in traits:
    df[tr] = df[tr].fillna(df[tr].mean())

# =====================
# T65 values across traits
# =====================
t65_rows = df[df["Genotype"] == "T65"].copy()
t65_values = {}

for tr in traits:
    if not t65_rows.empty and t65_rows[tr].notna().any():
        t65_values[tr] = t65_rows[tr].mean()
    else:
        t65_values[tr] = df[tr].mean()

# =====================
# Plot
# =====================
fig, axes = plt.subplots(3, 4, figsize=(22, 14))
axes = axes.flatten()

for i, tr in enumerate(traits):
    ax = axes[i]

    violin_data = []
    family_means = []
    parent_vals = []

    for fam in family_order:
        fam_df = df[df["Family"] == fam].copy()
        vals = fam_df[tr].dropna().values
        violin_data.append(vals)

        fam_mean = np.mean(vals)
        family_means.append(fam_mean)

        parent_name = parent_lookup[fam]
        parent_row = fam_df[fam_df["Genotype"] == parent_name]

        if not parent_row.empty and parent_row[tr].notna().any():
            parent_val = parent_row[tr].mean()
        else:
            parent_val = fam_mean

        parent_vals.append(parent_val)

    positions = np.arange(1, len(family_order) + 1)

    vp = ax.violinplot(
        violin_data,
        positions=positions,
        widths=0.8,
        showmeans=False,
        showmedians=False,
        showextrema=False
    )

    for body in vp["bodies"]:
        body.set_facecolor("lightgray")
        body.set_edgecolor("black")
        body.set_alpha(1)

    # Black dots = family means
    ax.scatter(positions, family_means, color="black", s=30, zorder=3)

    # Blue dots = parents
    ax.scatter(positions, parent_vals, color="blue", s=35, zorder=4)

    # Red dots = T65
    ax.scatter(positions, [t65_values[tr]] * len(positions),
               color="red", s=35, zorder=4)

    # ===== Bold x-axis labels =====
    ax.set_xticks(positions)
    ax.set_xticklabels(family_labels, rotation=90)

    for label in ax.get_xticklabels():
        label.set_fontweight("bold")
        label.set_color("black")
        label.set_fontsize(9)

    ax.set_title(tr, fontsize=12, fontweight="bold")

    for spine in ax.spines.values():
        spine.set_visible(True)
        spine.set_linewidth(1)

# ======================
# Use last empty panel for legend
# ======================
legend_ax = axes[len(traits)]
legend_ax.axis("off")

from matplotlib.lines import Line2D

legend_elements = [
    Line2D([0], [0], marker='o', color='w', label='Parent',
           markerfacecolor='blue', markersize=8),
    Line2D([0], [0], marker='o', color='w', label='T65',
           markerfacecolor='red', markersize=8),
    Line2D([0], [0], marker='o', color='w', label='Family mean',
           markerfacecolor='black', markersize=8)
]

legend_ax.legend(
    handles=legend_elements,
    loc='center',
    frameon=False,
    fontsize=12
)

# Remove any extra panels beyond legend
for j in range(len(traits) + 1, len(axes)):
    fig.delaxes(axes[j])

fig.suptitle("Trait distributions across NAM families",
             fontsize=16, fontweight="bold", y=0.98)

plt.tight_layout(rect=[0, 0, 1, 0.95])

plt.savefig("NAM_11traits_violin_panels_FINAL.png", dpi=300, bbox_inches="tight")
plt.savefig("NAM_11traits_violin_panels_FINAL.pdf", bbox_inches="tight")

plt.show()
