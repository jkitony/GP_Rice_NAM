import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# =====================
# Input
# =====================
file = "Phenos_2018_17fam_2249lines.csv"
df = pd.read_csv(file)

traits = ["DTH", "CL", "PL", "PRL", "PN", "PW", "SW", "NPB", "NSPP", "BM", "SSR"]

parent_lookup = {
    2: "WRC02",
    4: "WRC04",
    26: "WRC26",
    27: "WRC27",
    28: "WRC28",
    29: "WRC29",
    30: "WRC30",
    31: "WRC31",
    32: "WRC32",
    33: "WRC33",
    34: "WRC34",
    35: "WRC35",
    36: "WRC36",
    39: "WRC39",
    40: "WRC40",
    72: "WRC72",
    73: "WRC73"
}

family_order = list(parent_lookup.keys())
family_labels = [f"F{f}" for f in family_order]

# Ensure numeric
df["Family"] = pd.to_numeric(df["Family"], errors="coerce")

for tr in traits:
    df[tr] = pd.to_numeric(df[tr], errors="coerce")

# Keep only target families
df = df[df["Family"].isin(family_order)].copy()

# =====================
# Impute missing values by family mean within each trait
# =====================
for tr in traits:
    df[tr] = df.groupby("Family")[tr].transform(lambda x: x.fillna(x.mean()))

# If an entire family-trait is all NA, fill with overall trait mean
for tr in traits:
    df[tr] = df[tr].fillna(df[tr].mean())

# =====================
# T65 values across traits
# =====================
t65_rows = df[df["Genotype"] == "T65"].copy()
t65_values = {}

for tr in traits:
    if not t65_rows.empty and t65_rows[tr].notna().any():
        t65_values[tr] = t65_rows[tr].mean()
    else:
        t65_values[tr] = df[tr].mean()

# =====================
# Plot
# =====================
fig, axes = plt.subplots(3, 4, figsize=(22, 14))
axes = axes.flatten()

for i, tr in enumerate(traits):
    ax = axes[i]

    violin_data = []
    family_means = []
    parent_vals = []

    for fam in family_order:
        fam_df = df[df["Family"] == fam].copy()
        vals = fam_df[tr].dropna().values
        violin_data.append(vals)

        fam_mean = np.mean(vals)
        family_means.append(fam_mean)

        parent_name = parent_lookup[fam]
        parent_row = fam_df[fam_df["Genotype"] == parent_name]

        if not parent_row.empty and parent_row[tr].notna().any():
            parent_val = parent_row[tr].mean()
        else:
            parent_val = fam_mean

        parent_vals.append(parent_val)

    positions = np.arange(1, len(family_order) + 1)

    vp = ax.violinplot(
        violin_data,
        positions=positions,
        widths=0.8,
        showmeans=False,
        showmedians=False,
        showextrema=False
    )

    for body in vp["bodies"]:
        body.set_facecolor("lightgray")
        body.set_edgecolor("black")
        body.set_alpha(1)

    # Black dots = family means
    ax.scatter(positions, family_means, color="black", s=24, zorder=3, label="Family mean" if i == 0 else "")

    # Blue dots = parents
    ax.scatter(positions, parent_vals, color="blue", s=28, zorder=4, label="Parent" if i == 0 else "")

    # Red dots = T65
    ax.scatter(positions, [t65_values[tr]] * len(positions), color="red", s=28, zorder=4, label="T65" if i == 0 else "")

    ax.set_title(tr, fontsize=12, fontweight="bold")
    ax.set_xticks(positions)
    ax.set_xticklabels(family_labels, rotation=90, fontsize=7, fontweight="bold", color="black")
    ax.tick_params(axis='y', labelsize=8)

    for spine in ax.spines.values():
        spine.set_visible(True)
        spine.set_linewidth(1)

# Remove unused 12th panel
for j in range(len(traits), len(axes)):
    fig.delaxes(axes[j])

handles, labels = axes[0].get_legend_handles_labels()
fig.legend(
    handles, labels,
    loc="upper center",
    ncol=3,
    frameon=False,
    fontsize=26,        # bigger text
    markerscale=1.8     # bigger dots in legend
)

fig.suptitle("", fontsize=16, fontweight="bold", y=0.98)
plt.tight_layout(rect=[0, 0, 1, 0.95])

plt.savefig("NAM_11traits_violin_panels.png", dpi=300, bbox_inches="tight")
plt.savefig("NAM_11traits_violin_panels.pdf", bbox_inches="tight")
plt.show()
