#!/usr/bin/env python3

import numpy as np
import pandas as pd
from cyvcf2 import VCF
from sklearn.impute import SimpleImputer
from scipy.spatial.distance import pdist, squareform
from Bio.Phylo.TreeConstruction import DistanceMatrix, DistanceTreeConstructor
from Bio import Phylo

# =========================
# Inputs
# =========================
vcf_file = "WNAM_merged.vcf"
meta_file = "wnamP2.csv"
out_prefix = "NJ_tree"

print("[INFO] Reading VCF...")
vcf = VCF(vcf_file)
samples = list(vcf.samples)

geno_rows = []
for variant in vcf:
    row = []
    for gt in variant.genotypes:
        a1, a2 = gt[0], gt[1]

        if a1 == -1 or a2 == -1:
            row.append(np.nan)
        elif a1 == 0 and a2 == 0:
            row.append(-1)
        elif (a1 == 0 and a2 == 1) or (a1 == 1 and a2 == 0):
            row.append(0)
        elif a1 == 1 and a2 == 1:
            row.append(1)
        else:
            row.append(np.nan)
    geno_rows.append(row)

X = np.array(geno_rows, dtype=float).T
print(f"[INFO] Matrix shape: {X.shape[0]} samples x {X.shape[1]} markers")

print("[INFO] Imputing missing genotypes...")
imputer = SimpleImputer(strategy="mean")
X_imp = imputer.fit_transform(X)

print("[INFO] Computing pairwise distances...")
dist_array = pdist(X_imp, metric="euclidean")
dist_square = squareform(dist_array)

lower_triangle = []
for i in range(len(samples)):
    lower_triangle.append(list(dist_square[i, :i+1]))

dm = DistanceMatrix(names=samples, matrix=lower_triangle)

print("[INFO] Building NJ tree...")
constructor = DistanceTreeConstructor()
tree = constructor.nj(dm)

try:
    tree.root_at_midpoint()
except Exception:
    pass

print("[INFO] Saving Newick tree...")
Phylo.write(tree, f"{out_prefix}.nwk", "newick")

print("[INFO] Saving sample-family table...")
meta = pd.read_csv(meta_file, index_col=0)
meta = meta.reset_index()
meta.columns = ["Sample"] + list(meta.columns[1:])

if "Family" not in meta.columns:
    raise ValueError("Metadata must contain a 'Family' column.")

meta[["Sample", "Family"]].to_csv("sample_family.tsv", sep="\t", index=False)

print("[INFO] Done.")
print(f"  Saved: {out_prefix}.nwk")
print("  Saved: sample_family.tsv")

