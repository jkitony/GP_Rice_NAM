#!/usr/bin/env python3

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from sklearn.decomposition import PCA
from sklearn.impute import SimpleImputer
from cyvcf2 import VCF


# =========================
# Input files
# =========================
vcf_file = "Fourteen.vcf"
meta_file = "wnamP2.csv"
outdir = "pca_plots"
os.makedirs(outdir, exist_ok=True)


# =========================
# Read VCF and encode genotypes
# 0/0 -> -1
# 0/1 or 1/0 -> 0
# 1/1 -> 1
# missing -> NaN
# =========================
vcf = VCF(vcf_file)
samples = vcf.samples

geno_list = []
variant_ids = []

for variant in vcf:
    gt_row = []
    for g in variant.genotypes:
        # g format from cyvcf2: [allele1, allele2, phased]
        a1, a2 = g[0], g[1]

        if a1 == -1 or a2 == -1:
            gt_row.append(np.nan)
        elif a1 == 0 and a2 == 0:
            gt_row.append(-1)
        elif (a1 == 0 and a2 == 1) or (a1 == 1 and a2 == 0):
            gt_row.append(0)
        elif a1 == 1 and a2 == 1:
            gt_row.append(1)
        else:
            # For multi-allelic or unexpected cases
            gt_row.append(np.nan)

    geno_list.append(gt_row)
    variant_ids.append(f"{variant.CHROM}_{variant.POS}")

# variants x samples
gt_matrix = np.array(geno_list, dtype=float)

# transpose to samples x variants
X = gt_matrix.T

geno_df = pd.DataFrame(X, index=samples, columns=variant_ids)
print(f"Genotype matrix shape (samples x markers): {geno_df.shape}")


# =========================
# Impute missing values
# =========================
imputer = SimpleImputer(strategy="mean")
X_imp = imputer.fit_transform(geno_df.values)


# =========================
# PCA
# =========================
n_pcs = 6
pca = PCA(n_components=n_pcs)
scores = pca.fit_transform(X_imp)
explained = pca.explained_variance_ratio_ * 100

scores_df = pd.DataFrame(
    scores,
    index=geno_df.index,
    columns=[f"PC{i}" for i in range(1, n_pcs + 1)]
).reset_index().rename(columns={"index": "Sample"})

scores_df.to_csv(os.path.join(outdir, "pca_scores.tsv"), sep="\t", index=False)

print("\nExplained variance (%):")
for i, v in enumerate(explained, start=1):
    print(f"PC{i}: {v:.2f}%")

print(f"\nTotal variance explained by first {n_pcs} PCs: {explained.sum():.2f}%")


# =========================
# Read metadata and merge
# Assumes first column in wnamP2.csv contains sample IDs
# =========================
meta = pd.read_csv(meta_file)

# If first column is sample ID but unnamed, rename it
if meta.columns[0] != "Sample":
    meta = meta.rename(columns={meta.columns[0]: "Sample"})

df = pd.merge(scores_df, meta, on="Sample", how="left")

# Save merged table
df.to_csv(os.path.join(outdir, "pca_scores_with_metadata.tsv"), sep="\t", index=False)


# =========================
# Family order, colors, shapes
# =========================
family_order = [
    "WNAM_02", "WNAM_04", "WNAM_27", "WNAM_28",
    "WNAM_29", "WNAM_30", "WNAM_31", "WNAM_32",
    "WNAM_33", "WNAM_34", "WNAM_35", "WNAM_36",
    "WNAM_39", "WNAM_40"
]

# Approximate Python colors corresponding to your R palette
family_colors = {
    "WNAM_02": "magenta",
    "WNAM_04": "coral",
    "WNAM_27": "yellowgreen",
    "WNAM_28": "aquamarine",
    "WNAM_29": "cornflowerblue",
    "WNAM_30": "orchid",
    "WNAM_31": "lightcoral",
    "WNAM_32": "cyan",
    "WNAM_33": "violet",
    "WNAM_34": "green",
    "WNAM_35": "saddlebrown",
    "WNAM_36": "black",
    "WNAM_39": "khaki",
    "WNAM_40": "darkcyan"
}

# matplotlib marker options
family_markers = {
    "WNAM_02": "s",   # square
    "WNAM_04": "+",
    "WNAM_27": "^",
    "WNAM_28": "P",
    "WNAM_29": "D",
    "WNAM_30": "v",
    "WNAM_31": "X",
    "WNAM_32": "*",
    "WNAM_33": "<",
    "WNAM_34": ">",
    "WNAM_35": "h",
    "WNAM_36": "o",
    "WNAM_39": "8",
    "WNAM_40": "d"
}

df["Family"] = pd.Categorical(df["Family"], categories=family_order, ordered=True)
df = df.sort_values("Family")


# =========================
# Plot function
# =========================
def plot_pca(df, x_pc, y_pc, explained, outfile_base, divide_by_10=False):
    fig, ax = plt.subplots(figsize=(10, 8))

    x_col = x_pc
    y_col = y_pc

    for fam in family_order:
        sub = df[df["Family"] == fam].copy()
        if sub.empty:
            continue

        x = sub[x_col].values
        y = sub[y_col].values

        if divide_by_10:
            x = x / 10.0
            y = y / 10.0

        ax.scatter(
            x,
            y,
            s=70,
            c=family_colors.get(fam, "gray"),
            marker=family_markers.get(fam, "o"),
            edgecolors="black",
            linewidths=0.8,
            alpha=0.9,
            label=fam
        )

    x_num = int(x_pc.replace("PC", ""))
    y_num = int(y_pc.replace("PC", ""))

    ax.set_xlabel(f"{x_pc} ({explained[x_num - 1]:.2f}%)", fontsize=14, fontweight="bold")
    ax.set_ylabel(f"{y_pc} ({explained[y_num - 1]:.2f}%)", fontsize=14, fontweight="bold")
    ax.set_title(f"{x_pc} vs {y_pc}", fontsize=15, fontweight="bold")

    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_linewidth(1.8)
    ax.spines["bottom"].set_linewidth(1.8)
    ax.tick_params(axis="both", labelsize=12, width=1.5)

    legend_elements = []
    for fam in family_order:
        legend_elements.append(
            Line2D(
                [0], [0],
                marker=family_markers.get(fam, "o"),
                color="w",
                label=fam,
                markerfacecolor=family_colors.get(fam, "gray"),
                markeredgecolor="black",
                markersize=9,
                linewidth=0
            )
        )

    ax.legend(
        handles=legend_elements,
        title="Family",
        title_fontsize=12,
        fontsize=10,
        loc="upper center",
        bbox_to_anchor=(0.5, 1.18),
        ncol=4,
        frameon=False
    )

    plt.tight_layout()
    plt.savefig(f"{outfile_base}.pdf", bbox_inches="tight")
    plt.savefig(f"{outfile_base}.png", dpi=300, bbox_inches="tight")
    plt.close()


# =========================
# Make the four requested plots
# =========================
pairs = [
    ("PC1", "PC2"),
    ("PC1", "PC3"),
    ("PC2", "PC3"),
    ("PC3", "PC4")
]

for x_pc, y_pc in pairs:
    outbase = os.path.join(outdir, f"{x_pc}_vs_{y_pc}")
    plot_pca(df, x_pc, y_pc, explained, outbase, divide_by_10=False)


# =========================
# Optional combined 2x2 panel
# =========================
fig, axes = plt.subplots(2, 2, figsize=(14, 12))
axes = axes.flatten()

for ax, (x_pc, y_pc) in zip(axes, pairs):
    for fam in family_order:
        sub = df[df["Family"] == fam]
        if sub.empty:
            continue

        ax.scatter(
            sub[x_pc],
            sub[y_pc],
            s=60,
            c=family_colors.get(fam, "gray"),
            marker=family_markers.get(fam, "o"),
            edgecolors="black",
            linewidths=0.7,
            alpha=0.9
        )

    x_num = int(x_pc.replace("PC", ""))
    y_num = int(y_pc.replace("PC", ""))

    ax.set_xlabel(f"{x_pc} ({explained[x_num - 1]:.2f}%)", fontsize=12, fontweight="bold")
    ax.set_ylabel(f"{y_pc} ({explained[y_num - 1]:.2f}%)", fontsize=12, fontweight="bold")
    ax.set_title(f"{x_pc} vs {y_pc}", fontsize=13, fontweight="bold")
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_linewidth(1.5)
    ax.spines["bottom"].set_linewidth(1.5)
    ax.tick_params(axis="both", labelsize=10, width=1.2)

legend_elements = []
for fam in family_order:
    legend_elements.append(
        Line2D(
            [0], [0],
            marker=family_markers.get(fam, "o"),
            color="w",
            label=fam,
            markerfacecolor=family_colors.get(fam, "gray"),
            markeredgecolor="black",
            markersize=8,
            linewidth=0
        )
    )

fig.legend(
    handles=legend_elements,
    title="Family",
    loc="upper center",
    bbox_to_anchor=(0.5, 1.02),
    ncol=4,
    frameon=False,
    fontsize=10,
    title_fontsize=11
)

plt.tight_layout()
plt.savefig(os.path.join(outdir, "PCA_combined_2x2.pdf"), bbox_inches="tight")
plt.savefig(os.path.join(outdir, "PCA_combined_2x2.png"), dpi=300, bbox_inches="tight")
plt.close()

print(f"\nDone. Output written to: {outdir}")
