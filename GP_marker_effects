#############################
# Helper: marker density from panel name
#############################
get_marker_density <- function(panel_name) {
  as.numeric(sub(".*_(\\d+)k$", "\\1", panel_name)) * 1000
}

#############################
# Helper: read and encode VCF
#############################
prepare_marker_data <- function(vcf_file) {
  vcf <- read.vcfR(vcf_file, verbose = FALSE)
  
  gt <- extract.gt(vcf)
  
  gt.score <- matrix(NA, nrow(gt), ncol(gt))
  gt.score[gt == "0/0"] <- -1
  gt.score[gt == "0/1"] <- 0
  gt.score[gt == "1/1"] <- 1
  
  rownames(gt.score) <- rownames(gt)
  colnames(gt.score) <- colnames(gt)
  
  gt.score <- t(gt.score)
  
  # Impute only marker missingness
  impute <- A.mat(
    gt.score,
    max.missing = 0.5,
    impute.method = "mean",
    return.imputed = TRUE
  )
  
  GD <- as.data.frame(impute$imputed)
  GD <- rownames_to_column(GD, var = "Genotype")
  return(GD)
}

#############################
# Helper: create fixed folds per trait
# Same phenotype folds are used within each panel
#############################
make_trait_folds <- function(data_pg, traits, folds = 5, seed = 723641600) {
  set.seed(seed)
  fold_list <- list()
  
  for (tr in traits) {
    idx <- which(!is.na(data_pg[[tr]]))
    n <- length(idx)
    
    if (n < folds + 2) next
    
    fold_assign <- sample(rep(1:folds, length.out = n))
    
    fold_list[[tr]] <- list(
      valid_rows = idx,
      fold_assign = fold_assign
    )
  }
  
  return(fold_list)
}

#############################
# Helper: run CV for one trait and one model
#############################
run_cv_trait <- function(data_pg, trait_name, fold_info,
                         marker_start_col,
                         model = c("rrBLUP", "RKHS", "BayesB", "BL"),
                         replications = 1,
                         nIter = 50, burnIn = 15, h = 0.5) {
  
  model <- match.arg(model)
  
  if (is.null(fold_info[[trait_name]])) return(NULL)
  
  keep_idx   <- fold_info[[trait_name]]$valid_rows
  tst_assign <- fold_info[[trait_name]]$fold_assign
  
  subdat <- data_pg[keep_idx, , drop = FALSE]
  
  y <- subdat[[trait_name]]
  X <- as.matrix(subdat[, marker_start_col:ncol(subdat)])
  
  n <- nrow(X)
  p <- ncol(X)
  folds <- length(unique(tst_assign))
  
  # Precompute model matrices
  if (model == "rrBLUP") {
    K <- A.mat(X, impute.method = "EM", n.core = 4, max.missing = 0.5, shrink = TRUE)
  }
  
  if (model == "RKHS") {
    D <- (as.matrix(dist(X, method = "euclidean"))^2) / p
    U <- exp(-h * D)
  }
  
  all_fold_acc <- c()
  rep_means <- c()
  
  for (r in seq_len(replications)) {
    fold_acc <- rep(NA_real_, folds)
    
    for (i in seq_len(folds)) {
      test_idx <- which(tst_assign == i)
      
      yNA <- y
      yNA[test_idx] <- NA
      
      if (model == "rrBLUP") {
        fit <- mixed.solve(y = yNA, K = K)
        yhat <- fit$u[test_idx]
      }
      
      if (model == "RKHS") {
        ETA <- list(list(K = U, model = "RKHS"))
        fit <- BGLR(y = yNA, ETA = ETA, nIter = nIter, burnIn = burnIn, verbose = FALSE)
        yhat <- fit$yHat[test_idx]
      }
      
      if (model == "BayesB") {
        ETA <- list(list(X = X, model = "BayesB"))
        fit <- BGLR(y = yNA, ETA = ETA, nIter = nIter, burnIn = burnIn, verbose = FALSE)
        yhat <- fit$yHat[test_idx]
      }
      
      if (model == "BL") {
        ETA <- list(list(X = X, model = "BL"))
        fit <- BGLR(y = yNA, ETA = ETA, nIter = nIter, burnIn = burnIn, verbose = FALSE)
        yhat <- fit$yHat[test_idx]
      }
      
      obs <- y[test_idx]
      
      if (length(test_idx) > 1 && sd(obs, na.rm = TRUE) > 0 && sd(yhat, na.rm = TRUE) > 0) {
        fold_acc[i] <- cor(yhat, obs, use = "complete.obs")
      } else {
        fold_acc[i] <- NA
      }
    }
    
    all_fold_acc <- c(all_fold_acc, fold_acc)
    rep_means <- c(rep_means, mean(fold_acc, na.rm = TRUE))
  }
  
  return(data.frame(
    Trait = trait_name,
    Model = model,
    N_used = n,
    Mean_Accuracy = mean(rep_means, na.rm = TRUE),
    SE_Accuracy = sd(all_fold_acc, na.rm = TRUE) / sqrt(sum(!is.na(all_fold_acc)))
  ))
}

#############################
# Main analysis loop
#############################
all_results <- list()

for (panel_name in names(vcf_files)) {
  cat("Running panel:", panel_name, "\n")
  
  GD <- prepare_marker_data(vcf_files[[panel_name]])
  data_pg <- merge(Year18_data, GD, by = "Genotype")
  
  ycols <- trait_order[trait_order %in% colnames(data_pg)]
  
  # Marker columns begin after merged phenotype columns
  marker_start_col <- which(colnames(data_pg) == colnames(GD)[2])
  
  # Fixed folds for this panel
  fold_info <- make_trait_folds(data_pg, traits = ycols, folds = 5, seed = 723641600)
  
  panel_results <- list()
  
  for (tr in ycols) {
    panel_results[[paste0(tr, "_rrBLUP")]] <- run_cv_trait(
      data_pg = data_pg,
      trait_name = tr,
      fold_info = fold_info,
      marker_start_col = marker_start_col,
      model = "rrBLUP",
      replications = 2
    )
    
    panel_results[[paste0(tr, "_RKHS")]] <- run_cv_trait(
      data_pg = data_pg,
      trait_name = tr,
      fold_info = fold_info,
      marker_start_col = marker_start_col,
      model = "RKHS",
      replications = 1,
      nIter = 50,
      burnIn = 15,
      h = 0.5
    )
    
    panel_results[[paste0(tr, "_BayesB")]] <- run_cv_trait(
      data_pg = data_pg,
      trait_name = tr,
      fold_info = fold_info,
      marker_start_col = marker_start_col,
      model = "BayesB",
      replications = 1,
      nIter = 50,
      burnIn = 15
    )
    
    panel_results[[paste0(tr, "_BL")]] <- run_cv_trait(
      data_pg = data_pg,
      trait_name = tr,
      fold_info = fold_info,
      marker_start_col = marker_start_col,
      model = "BL",
      replications = 1,
      nIter = 50,
      burnIn = 15
    )
  }
  
  panel_df <- bind_rows(panel_results)
  panel_df$Panel <- panel_name
  panel_df$Marker_Density <- get_marker_density(panel_name)
  
  all_results[[panel_name]] <- panel_df
}

results_df <- bind_rows(all_results)

