library(ggplot2)
library(dplyr)

outdir <- "cross_performance_rrBLUP_2018_56k"

results <- read.csv(file.path(outdir, "predicted_cross_performance_all_traits.csv"))

# Requested trait order
trait_order <- c(
  "DTH", "CL", "PL", "PRL",
  "PN", "PW", "SW", "NPB",
  "NSPP", "BM", "SSR"
)

results_rel <- results %>%
  mutate(Trait = factor(Trait, levels = trait_order)) %>%
  group_by(Trait) %>%
  mutate(
    UC_rel = Usefulness_Criterion - mean(Usefulness_Criterion, na.rm = TRUE)
  ) %>%
  ungroup()

top_rel <- results_rel %>%
  group_by(Trait) %>%
  slice_max(order_by = UC_rel, n = 15, with_ties = FALSE) %>%
  ungroup()

# Order crosses within each trait separately
top_rel <- top_rel %>%
  arrange(Trait, UC_rel) %>%
  mutate(Cross_trait = paste(Cross, Trait, sep = "___"))

p_rel <- ggplot(
  top_rel,
  aes(x = reorder(Cross_trait, UC_rel), y = UC_rel)
) +
  geom_col(width = 0.72) +
  coord_flip() +
  facet_wrap(~Trait, scales = "free_y", ncol = 4) +
  scale_x_discrete(
    labels = function(x) sub("___.*$", "", x)
  ) +
  labs(
    title = "Top 15 Predicted Crosses Based on Relative UC Within Each Trait",
    x = "Cross",
    y = "UC relative to trait mean"
  ) +
  theme_classic() +
  theme(
    strip.text = element_text(face = "bold", size = 10, color = "black"),
    axis.text.y = element_text(size = 5.8, color = "black"),
    axis.text.x = element_text(size = 6.2, color = "black"),
    axis.title.x = element_text(face = "bold", size = 8, color = "black"),
    axis.title.y = element_text(face = "bold", size = 8, color = "black"),
    plot.title = element_text(face = "bold", size = 10, hjust = 0.5),
    panel.spacing = unit(0.9, "lines"),
    plot.margin = margin(6, 8, 6, 6)
  )

ggsave(
  file.path(outdir, "Top_Crosses_RELATIVE_improved.png"),
  p_rel,
  width = 6.2,
  height = 5.2,
  dpi = 600
)

ggsave(
  file.path(outdir, "Top_Crosses_RELATIVE_improved.pdf"),
  p_rel,
  width = 6.2,
  height = 4.8
)
